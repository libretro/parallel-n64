# GLideNHQ's texture filters, its gzip files, its resampler, its quantizer,
# its image files, its checksums, pool and buffers, and its texture caches
# (C89)
SOURCES_C += $(VIDEODIR_GLIDEN64)/src/GLideNHQ/TextureFilters.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TextureFilters_2xsai.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TextureFilters_hq2x.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TextureFilters_hq4x.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TextureFilters_xbrz.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxGz.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxReSample.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxQuantize.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxImage.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxUtil.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxCache.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxTexCache.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxHiResCache.c \
	$(VIDEODIR_GLIDEN64)/src/GLideNHQ/TxFilter.c

# GLideNHQ's persistent filter/quantize pool (C89)
SOURCES_C += $(VIDEODIR_GLIDEN64)/src/GLideNHQ/txpool.c

ifeq ($(HAVE_NEON),1)
	SOURCES_C     += $(VIDEODIR_GLIDEN64)/src/Neon/3DMathNeon.c \
					 $(VIDEODIR_GLIDEN64)/src/Neon/gSPNeon.c
else
	SOURCES_C     += $(VIDEODIR_GLIDEN64)/src/3DMath.c
endif
endif

ifneq (,$(filter 1,$(HAVE_GLIDEN64) $(HAVE_GLN64) $(HAVE_RICE)))
SOURCES_C     += $(VIDEODIR_GLIDEN64)/src/CombinerKeyJournal.c
